<?xml version="1.0" encoding="utf-8"?>
<!-- The API key is encrypted with a Keystore key that never leaves the device, so a restored copy cannot be decrypted. -->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
